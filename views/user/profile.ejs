<%- include('../includes/header.ejs') %>
</head>

<body>
  <%- include('../includes/navbar.ejs') %>
  <div class="content-wrapper container">
    <div class="page-heading">
      <span class="h3">My Profile</span>
    </div>
    <div class="page-content">
      <section class="row">
        <div class="col-12 col-lg-6">
          <div class="card">
            <div class="card-header">
              <strong>My Profile</strong>
            </div>
            <div class="card-body">
              <div class="row">
                <div class="col-md-3 mb-1 col-sm-12">
                  Faculty Code:
                </div>
                <div class="col-md-9 col-sm-12" id="facultyCode">
                  Academic Qualifications
                </div>
              </div>
              <div class="row">
                <div class="col-md-3 mb-1 col-sm-12">
                  Name:
                </div>
                <div class="col-md-9 col-sm-12" id="name">
                  Academic Qualifications
                </div>
              </div>
              <div class="row">
                <div class="col-md-3 mb-1 col-sm-12">
                  Email:
                </div>
                <div class="col-md-9 col-sm-12" id="email">
                  Academic Qualifications
                </div>
              </div>
              <div class="row">
                <div class="col-md-3 mb-1 col-sm-12">
                  Faculty Type:
                </div>
                <div class="col-md-9 col-sm-12" id="facultyType">
                  Academic Qualifications
                </div>
              </div>
            </div>

          </div>
        </div>
        <div class="col-12 col-lg-6">
          <div class="card">
            <div class="card-header">
              <strong>Subject Qualifications</strong>
            </div>
            <div class="card-body">
              <div class="row mb-3">
                <div class="col-12">
                  Academic Qualifications
                </div>
              </div>
              <div class="row mb-3">
                <div class="col-12">
                  <div id="academicQualifications">

                  </div>
                </div>
              </div>
              <div class="row mb-3">
                <div class="col-12">
                  Course Taken
                </div>
              </div>
              <div class="row">
                <div class="col-12">
                  <div id="courseTaken">

                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>

  <input type="hidden" value="<%= csrf %>" id="csrf">
  <%- include('../includes/footer.ejs') %>
  <script>
    const userId = '<%= userId %>'
  </script>
  <script src="/js/user/profile.js"></script>

</body>

</html>