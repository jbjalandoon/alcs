<%- include('../includes/header.ejs') %>
</head>

<body>
  <%- include('../includes/navbar.ejs') %>
  <div class="content-wrapper container">
    <div class="page-heading">
      <span class="h3">My Schedule</span>
    </div>
    <div class="page-content">
      <section class="row">
        <div class="col-12">
          <div class="card">
            <div class="card-body">
              <div class="row">
                <div class="col-12">
                  <ul class="nav nav-tabs" id="myTab" role="tablist">
                    <li class="nav-item" role="presentation">
                      <button class="nav-link active" id="home-tab" data-bs-toggle="tab" data-bs-target="#home-tab-pane" type="button" role="tab" aria-controls="home-tab-pane" aria-selected="true">Timetable View</button>
                    </li>
                    <li class="nav-item" role="presentation">
                      <button class="nav-link" id="profile-tab" data-bs-toggle="tab" data-bs-target="#profile-tab-pane" type="button" role="tab" aria-controls="profile-tab-pane" aria-selected="false">Table View</button>
                    </li>
                  </ul>
                </div>
              </div>
              <div class="row">
                <div class="col-12">
                  <div class="tab-content" id="myTabContent">
                    <div class="tab-pane fade show active" id="home-tab-pane" role="tabpanel" aria-labelledby="home-tab" tabindex="0">
                      <div class="container mt-3">
                        <div class="row">
                          <div class="col-12">
                            <button class="float-left btn btn-primary d-none" id="downloadSpreadsheet">Download</button>
                          </div>
                        </div>
                        <div class="row">
                          <div class="col-12">
                            <div id="calendarContainer">
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                    <div class="tab-pane fade" id="profile-tab-pane" role="tabpanel" aria-labelledby="profile-tab" tabindex="0">
                      <div class="container mt-3">
                        <div class="row">
                          <div class="col-12">
                            <button class="float-left btn btn-primary d-none" id="downloadTable">Download</button>
                          </div>
                        </div>
                        <div class="row">
                          <div class="col-12">
                            <div class="table-reponsive">
                              <table class="table" id="scheduleTable">
                                <thead>
                                  <tr>
                                    <th>Course Code</th>
                                    <th>Course Description</th>
                                    <th>Units</th>
                                    <th>Schedule</th>
                                  </tr>
                                </thead>
                                <tbody>

                                </tbody>
                              </table>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>
  <input type="hidden" value="<%= csrf %>" id="csrf">
  <input type="hidden" value="<%= userId %>" id="userId">
  <%- include('../includes/footer.ejs') %>
  
  <script src="/js/user/schedule.js"></script>

</body>

</html>