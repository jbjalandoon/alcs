<%- include('../includes/header.ejs') %>
</head>

<body>
  <%- include('../includes/navbar.ejs') %>
  <div class="content-wrapper container">
    <div class="page-heading">
      <span class="h3">My Schedule</span>
    </div>
    <div class="page-content">
      <section class="row">
        <div class="col-12">
          <div class="card">
            <div class="card-body">
              <div class="row">
                <div class="col-12">
                  <div class="owl-carousel owl-theme">
                    <div class="item">
                      <div class="row">
                        <div class="col-12">
                          <button class="btn btn-primary" id="downloadSpreadsheetCalendar">Download</button>
                        </div>
                      </div>
                      <div class="row">
                        <div class="col-12">
                          <div id="calendarContainer"></div>
                        </div>
                      </div>
                    </div>
                    <div class="item">
                      <div class="row">
                        <div class="col-12">
                          <button class="btn btn-primary" id="downloadSpreadsheetTable">Download</button>
                        </div>
                      </div>
                      <div class="row">
                        <div class="col-12">
                          <div class="table-responsive">
                            <table class="table table-bordered table-stripe mt-3" id="scheduleTable">
                              <thead>
                                <tr>
                                  <th width="15%">Course Code</th>
                                  <th width="25%">Course</th>
                                  <th width="5%">Units</th>
                                  <th width="5%">Lecture</th>
                                  <th width="5%">Lab</th>
                                  <th width="35%">Schedule</th>
                                </tr>
                              </thead>
                              <tbody class="table-group-divider">

                              </tbody>
                            </table>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                 
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>
  <input type="hidden" value="<%= csrf %>" id="csrf">
  <input type="hidden" value="<%= userId %>" id="userId">
  <%- include('../includes/footer.ejs') %>

  <script src="/js/user/schedule.js"></script>

</body>

</html>