<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password</title>
    <link rel="stylesheet" href="/assets/css/main/app.css" />
    <link rel="stylesheet" href="/assets/css/pages/auth.css" />
    <link
      rel="shortcut icon"
      href="/assets/images/logo/favicon.svg"
      type="image/x-icon"
    />
    <link
      rel="shortcut icon"
      href="/assets/images/logo/favicon.png"
      type="image/png"
    />
  </head>

  <body>
    <div id="auth">
      <div class="row h-100">
        <div class="col-lg-5 col-12">
          <div id="auth-left">
            <div class="auth-logo">
              <a href="/authentication/login"
                ><img src="/assets/images/logo/logo.svg" alt="Logo"
              /></a>
            </div>
            <h1 class="auth-title">Forgot Password</h1>
            <p class="auth-subtitle mb-5">
              Input your email and we will send you reset password link.
            </p>

            <form id="forgotForm">
              <div class="form-group position-relative has-icon-left mb-4">
                <input
                  type="email"
                  id="email"
                  class="form-control form-control-xl"
                  name="email"
                  placeholder="Email"
                />
                <div class="form-control-icon">
                  <i class="bi bi-envelope"></i>
                </div>
              </div>
              <input type="hidden" name="_csrf" id="csrf" value="<%= csrf %>" />
              <div class="alert alert-danger d-none" id="alert">
                <h4 class="alert-heading">Login Failed</h4>
                <ul id="alertList"></ul>
              </div>
              <div class="alert alert-success d-none" id="successAlert">
                <h4 class="alert-heading">Password Request Link Sent</h4>
                <p>Please check your email for the link</p>
              </div>
              <button
                class="btn btn-primary btn-block btn-lg shadow-lg mt-2"
                type="submit"
                id="submit"
              >
                Send
              </button>
            </form>

            <div class="text-center mt-3 text-lg fs-4">
              <p class="text-gray-600">
                Remember your account?
                <a href="/authentication/login" class="font-bold">Log in</a>.
              </p>
            </div>
          </div>
        </div>
        <div class="col-lg-7 d-none d-lg-block">
          <div id="auth-right"></div>
        </div>
      </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script src="/js/forgot.js"></script>
  </body>
</html>
