<!doctype html>
<html lang="en">

<head>
  <title>Reset Password</title>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

  <link href="https://fonts.googleapis.com/css?family=Lato:300,400,700&display=swap" rel="stylesheet">

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-Zenh87qX5JnK2Jl0vWa8Ck2rdkQ2Bzep5IDxbcnCeuOxjzrPF/et3URy9Bv1WTRi" crossorigin="anonymous" />

  <link rel="stylesheet" href="/scss/login.css">
  <style>
    body {
      background-image: url("https://www.sti.edu/images/2022/fbimages/omnibus.jpg");
      background-repeat: no-repeat;
      background-size: cover;
    }
  </style>
</head>

<body>
  <section class="ftco-section">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
          <div class="login-wrap p-4 p-md-5">
            <h3 class="text-center mb-4">Reset Password</h3>
            <form action="/authentication/reset" method="POST" class="login-form" id="resetForm">
              <div class="form-group d-flex">
                <input type="password" name="newPassword" id="newPassword" class="form-control rounded-left" placeholder="New Password" required>
              </div>
              <div class="form-group d-flex">
                <input type="password" name="retypePassword" id="retypePassword" class="form-control rounded-left" placeholder="Retype Password" required>
              </div>
              <div class="alert alert-danger d-none" role="alert" id="alert">
                Password Doesnt Match
              </div>
              <div class="form-group">
                <input type="hidden" name="_csrf" value="<%= csrf %>">
                <input type="hidden" name="id" value="<%= userId %>">
                <button type="button" id="button" class="btn btn-primary rounded submit p-3 px-5">Submit</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>


  <script src="https://code.jquery.com/jquery-3.6.3.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-OERcA2EqjJCMA+/3y+gxIOqMEjwtxJY7qPCqsdltbNJuaOe923+mo//f6V8Qbsw3" crossorigin="anonymous"></script>
  <script>
    $('#button').on('click', () => {
      if ($('#newPassword').val() !== $('#retypePassword').val()) {
        return $('#alert').removeClass('d-none')
      }
      $('#resetForm').submit()


    })
  </script>
  <!-- <script src="js/main.js"></script> -->

</body>

</html>