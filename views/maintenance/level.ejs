<%- include('../includes/header.ejs') %>
</head>

<body>
  <%- include('../includes/navbar.ejs') %>
  <div class="content-wrapper container">
    <div class="page-heading">
      <span class="h3">List of Year Level</span>
      <button type="button" class="btn btn-sm btn-primary float-end" data-bs-toggle="modal" data-bs-target="#addModal">
        Add New Year Level
      </button>
    </div>
    <div class="page-content">
      <section class="row">
        <div class="col-12">
          <div class="card">
            <div class="card-body">
              <div class="table-responsive">
                <table id="levelTable" class="table table-striped" style="width:100%">
                  <thead>
                    <tr>
                      <th>Year Level</th>
                      <th>Display</th>
                      <th>Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>

  <div class="modal fade" id="addModal" tabindex="-1" aria-labelledby="addModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="addModalLabel">Adding Year Level</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <form class="needs-validation" novalidate>
          <div class="modal-body">
            <div class="mb-3">
              <label for="yearLevel" class="col-form-label">Year Level</label>
              <input type="text" class="form-control" id="yearLevel">
              <div class="invalid-feedback">
              </div>
            </div>
            <div class="mb-3">
              <label for="display" class="col-form-label">Display</label>
              <input type="text" class="form-control" id="display">
              <div class="invalid-feedback">
              </div>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            <button type="submit" class="btn btn-primary" id="addButton">Submit</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="editModalLabebl" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h1 class="modal-title fs-5" id="editModalLabebl">Editing Year Level</h1>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <form class="needs-validation">
          <div class="modal-body">
            <div class="mb-3">
              <label for="yearLevel" class="col-form-label">Year Level:</label>
              <input type="text" class="form-control" id="yearLevel">
              <div class="invalid-feedback">
              </div>
            </div>
            <div class="mb-3">
              <label for="display">Display:</label>
              <input type="text" class="form-control" id="display">
              <div class="invalid-feedback"></div>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            <button type="submit" class="btn btn-primary" id="editButton">Edit</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <input type="hidden" name="" value="<%= csrf %>" id="csrf">
  <%- include('../includes/footer.ejs') %>
  <script src="/js/level.js"></script>
</body>

</html>