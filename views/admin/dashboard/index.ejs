<%- include('../../includes/header.ejs') %>
</head>

<body>
  <%- include('../../includes/navbar.ejs') %>
  <div class="container-fluid mt-3">
    <div class="card">
      <div class="card-header">
        <strong id="cardTitle">Dashboard</strong>
        <button type="button" class="btn btn-sm btn-primary float-end" data-bs-toggle="modal" data-bs-target="#addModal">
          Set Active Semester
        </button>
      </div>
      <div class="card-body">
        <div class="container">
          <div class="row">
            <div class="col-sm-6 col-lg-3">
              <div class="card mb-4 text-white bg-info">
                <div class="card-body pb-5 d-flex justify-content-between align-items-start">
                  <div>
                    <div class="fs-4 fw-semibold"><span id="activeFaculty">0</span>
                      <div>Active Faculty</div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div class="col-sm-6 col-lg-3">
              <div class="card mb-4 text-white bg-info">
                <div class="card-body pb-5 d-flex justify-content-between align-items-start">
                  <div>
                    <div class="fs-4 fw-semibold"><span id="activeRoom">0</span>
                      <div>Active Room</div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div class="col-sm-6 col-lg-3">
              <div class="card mb-4 text-white bg-info">
                <div class="card-body pb-5 d-flex justify-content-between align-items-start">
                  <div>
                    <div class="fs-4 fw-semibold"><span id="unloadedSchedules">0</span>
                        <div>Unloaded Schedule</div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div class="col-sm-6 col-lg-3">
              <div class="card mb-4 text-white bg-info">
                <div class="card-body pb-5 d-flex justify-content-between align-items-start">
                  <div>
                    <div class="fs-4 fw-semibold"><span id="unassignedSchedule">0</span>
                        <div>Unassigned Schedule</div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="row">
            <div class="col-12">
              <ul class="nav nav-tabs" id="myTab" role="tablist">
                <li class="nav-item" role="presentation">
                  <button class="nav-link active" id="faculty-tab" data-bs-toggle="tab" data-bs-target="#faculty-tab-pane" type="button" role="tab" aria-controls="faculty-tab-pane" aria-selected="true">Faculty</button>
                </li>
                <li class="nav-item" role="presentation">
                  <button class="nav-link" id="section-tab" data-bs-toggle="tab" data-bs-target="#section-tab-pane" type="button" role="tab" aria-controls="section-tab-pane" aria-selected="false">
                    Room
                </li>
                <li class="nav-item" role="presentation">
                  <button class="nav-link" id="room-tab" data-bs-toggle="tab" data-bs-target="#room-tab-pane" type="button" role="tab" aria-controls="room-tab-pane" aria-selected="false">Section</button>
                </li>
              </ul>

            </div>
          </div>
          <div class="row">
            <div class="col-12">
              <div class="tab-content" id="myTabContent">
                <div class="tab-pane fade show active" id="faculty-tab-pane" role="tabpanel" aria-labelledby="faculty-tab" tabindex="0">
                  <div class="container mt-3">
                    <div class="row mb-3">
                      <div class="col-12">
                        <select name="" class="form-select" id="facultyView">
                        </select>
                      </div>
                    </div>
                    <div class="row">
                      <div class="col-12">
                        <button class="btn btn-primary" id="downloadCurrentFaculty">Download Current</button>
                        <button class="btn btn-primary" id="downloadAllFaculty">Download All</button>
                      </div>
                    </div>
                    <div class="row">
                      <div class="col-12">
                        <div id="facultyCalendar"></div>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="tab-pane fade" id="section-tab-pane" role="tabpanel" aria-labelledby="section-tab" tabindex="0">
                  <div class="container mt-3">
                    <div class="row mb-3">
                      <div class="col-12">
                        <select id="roomView"></select>
                      </div>
                    </div>
                    <div class="row">
                      <div class="col-12">
                        <button class="btn btn-primary" id="downloadCurrentRoom">Download Current</button>
                        <button class="btn btn-primary" id="downloadAllRoom">Download All</button>
                      </div>
                    </div>
                    <div class="row">
                      <div class="col-12">
                        <div id="roomCalendar">

                        </div>
                      </div>

                    </div>
                  </div>
                </div>
                <div class="tab-pane fade" id="room-tab-pane" role="tabpanel" aria-labelledby="room-tab" tabindex="0">
                  <div class="container mt-3">
                    <div class="row">
                      <div class="col-md-4 col-sm-12 mb-3 ">
                        <select name="" class="form-select" id="programView"></select>
                      </div>
                      <div class="col-md-4 col-sm-12 mb-3 ">
                        <select name="" class="form-select" id="yearView"></select>
                      </div>
                      <div class="col-md-4 col-sm-12 mb-3 ">
                        <select name="" class="form-select" id="sectionView"></select>
                      </div>
                    </div>
                    <div class="row">
                      <div class="col-12">
                        <button class="btn btn-primary" id="downloadCurrentSection">Download Current</button>
                        <button class="btn btn-primary" id="downloadAllSection">Download All</button>
                      </div>
                    </div>
                    <div class="row">
                      <div class="col-12">
                        <div id="sectionCalendar">

                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="modal fade" id="addModal" tabindex="-1" aria-labelledby="addModalLabel" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="addModalLabel">Set Active Semester</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <form id="activeSemesterForm" class="needs-validation" novalidate>
              <div class="mb-3">
                <label for="year" class="col-form-label">School Year:</label>
                <select class="form-select" id="year">
                </select>
                <div class="invalid-feedback">
                </div>
              </div>
              <div class="mb-3">
                <label for="semester" class="col-form-label">Semester:</label>
                <select class="form-select" id="semester" disabled>
                </select>
                <div class="invalid-feedback">
                </div>
              </div>
            </form>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            <button type="button" class="btn btn-primary disabled" id="addButton">Submit</button>
          </div>
        </div>
      </div>
    </div>
    <input type="hidden" value="<%= csrf %>" id="csrf">
    <%- include('../../includes/footer.ejs') %>
    <script src="/js/dashboard.js"></script>
</body>

</html>