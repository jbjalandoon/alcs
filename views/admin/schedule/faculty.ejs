<%- include('../../includes/header.ejs') %>
</head>

<body>
  <%- include('../../includes/navbar.ejs') %>
  <div class="container-fluid p-4">
    <div class="card">
      <div class="card-header">
        <strong>ASSIGN FACULTY</strong>
      </div>
      <div class="card-body">
        <div class="row">
          <div class="col-10 offset-1">
            <div class="d-flex justify-content-center mt-2" id="firstLoading">
              <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
              </div>
            </div>
            <div class="d-none" id="facultySelect">
              <label for="faculty" class="form-label">
                Select Faculty:
              </label>
              <select name="" class="form-control" id="faculty">
                <option value="" selected disabled>--Select Faculty--</option>
              </select>
            </div>
          </div>
        </div>
        <div class="row">
          <div class="col-4 mt-4">
            <div class="d-flex d-none justify-content-center m-4" id="loadingCourse">
              <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
              </div>
            </div>
            <div class="d-none" id="courses">
              <div class="mb-3">
                <select type="text" class="form-select form-lg mb-3" id="courseSearch">
                  <option value="" selected disabled>--Select Course--</option>
                </select>
              </div>
              <div class="d-flex d-none justify-content-center m-5" id="loadingList">
                <div class="spinner-border" role="status">
                  <span class="visually-hidden">Loading...</span>
                </div>
              </div>
              <div id="list">
                <ul class="nav nav-tabs" id="myTab" role="tablist">
                  <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="lecture-tab" data-bs-toggle="tab" data-bs-target="#lecture-tab-pane" type="button" role="tab" aria-controls="lecture-tab-pane" aria-selected="true">Lectures</button>
                  </li>
                  <li class="nav-item" role="presentation">
                    <button class="nav-link" id="lab-tab" data-bs-toggle="tab" data-bs-target="#lab-tab-pane" type="button" role="tab" aria-controls="lab-tab-pane" aria-selected="false">Laboratory</button>
                  </li>
                </ul>
                <div class="tab-content" id="myTabContent">
                  <div class="tab-pane fade show active" id="lecture-tab-pane" role="tabpanel" aria-labelledby="lecture-tab" tabindex="0">
                    <ol class="list-group list-group-numbered mt-3 schedules" id="lectureList">
                    </ol>
                  </div>
                  <div class="tab-pane fade" id="lab-tab-pane" role="tabpanel" aria-labelledby="lab-tab" tabindex="0">
                    <ol class="list-group list-group-numbered mt-3 schedules" id="labList">
                    </ol>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="col-8">
            <div id='calendar-container'>
              <div class="d-flex d-none justify-content-center m-5" id="loadingCalendar">
                <div class="spinner-border" role="status">
                  <span class="visually-hidden">Loading...</span>
                </div>
              </div>
              <div id="calendar" class="d-none"></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <input type="hidden" id="sem" value="<%= sem %>">
    <input type="hidden" id="csrf" value="<%= csrf %>">
    <%- include('../../includes/footer.ejs') %>
    <script src="/js/schedule-faculty.js"></script>
</body>

</html>
