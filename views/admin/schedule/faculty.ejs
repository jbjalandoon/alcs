<%- include('../../includes/header.ejs') %>
</head>

<body>
  <%- include('../../includes/navbar.ejs') %>
  <div class="content-wrapper container">
    <div class="page-heading">
      <span class="h3" id="pageTitle">Faculty Loading</span>
    </div>
    <div class="page-content">
      <section class="row">
        <div class="d-flex justify-content-between flex-sm-column flex-lg-row" id="facultyTypeLists">
        </div>
        <div class="col-12">
          <div class="card">
            <div class="card-body">
              <div class="row">
                <div class="col-12">
                  <div id="facultySelect">
                    <label for="faculty" class="form-label">
                      Faculty:
                    </label>
                    <select name="" class="form-control" id="faculty">
                    </select>
                  </div>
                </div>
              </div>
              <div class="row" id="contentRow">
                <div class="col-lg-4 mt-3 col-sm-12">
                  <div id="courses">
                    <div class="mb-3">
                      <label for="courseSearch" class="form-label">Select Course: </label>
                      <select type="text" class="form-select form-lg mb-3" id="courseSearch">
                      </select>
                    </div>
                    <div id="list">
                      <ol class="list-group list-group-numbered mt-3 schedules" id="courseList">
                      </ol>
                    </div>
                  </div>
                </div>
                <div class="col-lg-8 col-sm-12">
                  <div class="container-fluid mt-3">
                    <div class="row">
                      <div class="col-12">
                        <strong>Faculty Type: <span id="spanFacultyType">REGULAR</span></strong>
                      </div>
                    </div>
                    <div class="row">
                      <div class="col-12">
                        <strong>Units: </strong><span id="spanUnits">0</span> / <span id="spanMaxUnits">0</span>
                      </div>
                    </div>
                    <div class="row">
                      <div class="col-12">
                        <strong>Hours: </strong><span id="spanHours">0</span>
                      </div>
                    </div>
                    <div class="row">
                      <div class="col-12">
                        <span class="badge text-bg-primary">Lecture Schedule</span>
                        <span class="badge text-bg-info">Lab Schedule</span>
                        <span class="badge text-bg-danger">Overload Schedule</span>
                      </div>
                    </div>
                    <div class="row">
                      <div class="col-12">
                        <div id='calendarContainer'>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>
  <div class="container-fluid mt-3">
    <div class="card">

    </div>
  </div>

  <div class="modal fade" id="facultyModal" tabindex="-1" aria-labelledby="modalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
      <div class="modal-content">
        <div class="modal-header">
          <h1 class="modal-title fs-5" id="modalLabel">List of Faculty</h1>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="container">
            <div class="row">
              <div class="col-12">
                <div class="table-responsive">
                  <table class="table table-striped">
                    <thead>
                      <tr>
                        <th>Faculty Code</th>
                        <th>Name</th>
                        <th>Units Count</th>
                      </tr>
                    </thead>
                    <tbody>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        </div>
      </div>
    </div>
  </div>

  <input type="hidden" id="csrf" value="<%= csrf %>">
  <%- include('../../includes/footer.ejs') %>
  <script src="/js/schedule-faculty.js"></script>
</body>

</html>