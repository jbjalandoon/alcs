<div class="col-12 p-3">
  <table class="table">
    <thead>
      <tr>
        <th>Course Code</th>
        <th>Course Description</th>
        <th>Units</th>
        <th>Schedule</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% sections.schedules.forEach(schedule => { %>
      <tr>
        <td><%= schedule.course.course_code %></td>
        <td><%= schedule.course.course_description %></td>
        <td><%= schedule.course.units %></td>
        <td>
          <% if (schedule.day && schedule.start_time && schedule.end_time) { %>
          <%= schedule.room.room_name %>
          <%= schedule.day.toUpperCase() + ' ' + schedule.start_time + ' - '+ schedule.end_time %>
          <% } else { %>
          No Schedule Yet
          <% } %>
        </td>
        <td>
          <button type="button" class="btn btn-primary btm-sm" data-coreui-toggle="modal" data-coreui-target="#scheduleModal" data-coreui-whatever="<%= schedule.course._id %>">Assign Schedule</button>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
  <!-- Button trigger modal -->
  <div class="modal fade" id="scheduleModal" tabindex="-1" aria-labelledby="scheduleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="scheduleModalLabel">New message</h5>
          <button type="button" class="btn-close" data-coreui-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="container">
            <div class="row">
              <div class="col-4">
                <form id="assign-form">
                  <div class="mb-3">
                    <input type="hidden" class="form-control" id="course">
                    <input type="hidden" class="form-control" id="csrf" value="<%= csrf %>">
                  </div>
                  <div class="mb-3">
                    <label for="room" class="col-form-label">Room:</label>
                    <select name="" id="room" class="form-select">
                      <option value="" selected disabled>--Select Room--</option>
                      <% dropdowns.room.forEach(room => { %>
                      <option value="<%= room._id %>"><%= room.room_name %> </option>
                      <% }) %>
                    </select>
                  </div>
                  <div class="mb-3">
                    <label for="day" class="col-form-label">Day:</label>
                    <select name="" id="day" class="form-select" disabled>
                      <option value="" selected disabled>--Select Day--</option>
                      <option value="m">Monday</option>
                      <option value="t">Tuesday</option>
                      <option value="w">Wednesday</option>
                      <option value="th">Thursday</option>
                      <option value="f">Friday</option>
                      <option value="s">Saturaday</option>
                    </select>
                  </div>
                  <div class="mb-3">
                    <label for="from" class="col-form-label">From:</label>
                    <select name="" id="from" class="form-select" disabled>
                      <option value="" disabled selected>--Select Starting Time--</option>
                    </select>
                  </div>
                  <div class="mb-3">
                    <label for="to" class="col-form-label">To:</label>
                    <select name="" id="to" class="form-select" disabled>
                      <option value="" disabled selected>--Select Ending Time</option>
                    </select>
                  </div>
                </form>
              </div>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-coreui-dismiss="modal">Close</button>
          <button type="button" id="assignBtn" class="btn btn-primary">Confirm</button>
        </div>
      </div>
    </div>
  </div>
</div>
<script>
  scheduleCourseForm = $("#assign-form #course");
  scheduleRoomForm = $("#assign-form #room");
  scheduleFromForm = $("#assign-form #from");
  scheduleToForm = $("#assign-form #to");
  scheduleDayForm = $("#assign-form #day");
  csrf = $("#assign-form #csrf");

  assignSubmitButton = $("#assignBtn");

  scheduleModal = document.getElementById("scheduleModal");
  scheduleModal.addEventListener("show.coreui.modal", (event) => {
    const button = event.relatedTarget;

    const recipient = button.getAttribute("data-coreui-whatever");

    const modalTitle = scheduleModal.querySelector(".modal-title");
    const modalBodyInput = scheduleModal.querySelector(
      ".modal-body #course"
    );

    modalTitle.textContent = ` ${recipient}`;
    modalBodyInput.value = recipient;
  });

  scheduleRoomForm.on("change", () => {
    $.ajax({
      url: "http://localhost:3000/admin/schedules/room",
      type: "GET",
      data: {
        room: scheduleRoomForm.val(),
        school_year: $('#schedule-form #school_year').val(),
        semester: $('#schedule-form #semester').val(),
        program: $('#schedule-form #program').val(),
        year_level: $('#schedule-form #year_level').val(),
        section: $('#schedule-form #section').val(),
      },
      dataType: "json",
      success: (response) => {
        scheduleDayForm.attr("disabled", false);
        console.log(response);
      },
    });
  });

  scheduleDayForm.on("change", () => {
    $.ajax({
      url: 'http://localhost:3000/admin/schedules/unavailable',
      type: "GET",
      dataType: 'json',
      data: {
        room: scheduleRoomForm.val(),
        school_year: $('#schedule-form #school_year').val(),
        semester: $('#schedule-form #semester').val(),
        program: $('#schedule-form #program').val(),
        year_level: $('#schedule-form #year_level').val(),
        section: $('#schedule-form #section').val(),
        day: scheduleDayForm.val(),
      },
      success: (response) => {
        const time = [
          "7:00",
          "7:30",
          "8:00",
          "8:30",
          "9:00",
          "9:30",
          "10:00",
          "10:30",
          "11:00",
          "11:30",
          "12:00",
          "12:30",
          "13:00",
          "13:30",
          "14:00",
          "14:30",
          "15:00",
          "15:30",
          "16:00",
          "16:30",
          "17:00",
          "17:30",
          "18:00",
          "18:30",
          "19:00",
          "19:30",
          "20:00",
          "20:30",
          "21:00",
        ];
        const timeRemoved = [];
        response.room_schedule.forEach(schedule => {
          timeRemoved.push({
            from: schedule.from,
            to: schedule.to,
          })
        })
        response.section_schedule.forEach(schedule => {
          timeRemoved.push({
            from: schedule.from,
            to: schedule.to,
          })
        })
        timeRemoved.forEach(timeRemoved => {
          let index = time.indexOf(timeRemoved.from)
          let count = Math.abs(time.indexOf(timeRemoved.from) - time.indexOf(timeRemoved.to))
          console.log(count)
          if (index > -1) {
            time.splice(index, count)
          }
        })
        time.forEach(time => {
          let index = time.indexOf(timeRemoved.from)
          scheduleFromForm.append(new Option(
            time,
            time
          ))
        })
        scheduleFromForm.attr("disabled", false);
      },
    })
  });

  scheduleFromForm.on("change", () => {
    const time = [
      "7:00",
      "7:30",
      "8:00",
      "8:30",
      "9:00",
      "9:30",
      "10:00",
      "10:30",
      "11:00",
      "11:30",
      "12:00",
      "12:30",
      "13:00",
      "13:30",
      "14:00",
      "14:30",
      "15:00",
      "15:30",
      "16:00",
      "16:30",
      "17:00",
      "17:30",
      "18:00",
      "18:30",
      "19:00",
      "19:30",
      "20:00",
      "20:30",
      "21:00",
    ];
    const newTime = time.slice(time.indexOf(scheduleFromForm.val()))
    newTime.forEach(time => {
      scheduleToForm.append(new Option(
        time,
        time
      ))
    })
    scheduleToForm.attr("disabled", false);
  });

  assignSubmitButton.on("click", () => {
    $.ajax({
      url: "http://localhost:3000/admin/schedules/set",
      type: "POST",
      data: {
        course: scheduleCourseForm.val(),
        room: scheduleRoomForm.val(),
        from: scheduleFromForm.val(),
        to: scheduleToForm.val(),
        day: scheduleDayForm.val(),
        school_year: $('#schedule-form #school_year').val(),
        semester: $('#schedule-form #semester').val(),
        program: $('#schedule-form #program').val(),
        year_level: $('#schedule-form #year_level').val(),
        section: $('#schedule-form #section').val(),
        _csrf: csrf.val(),
      },
      dataType: "json",
      success: (response) => {
        if (response.message.acknowledged) {
          $.ajax({
            url: "http://localhost:3000/admin/schedules/courses",
            type: "GET",
            dataType: "html",
            data: {
              school_year: $('#schedule-form #school_year').val(),
              semester: $('#schedule-form #semester').val(),
              program: $('#schedule-form #program').val(),
              year_level: $('#schedule-form #year_level').val(),
              section: $('#schedule-form #section').val(),
            },
            success: (response) => {
              Swal.fire('Success!', 'You have successfully assigned a schedudle', 'success').then(() => {
                $("#scheduleModal").modal('hide');
                scheduleTable.html(response);
              })
            },
          });
        } else {
          Swal.fire('Error!', 'Something went wrong!', 'error').then(() => {
            $("#scheduleModal").modal('hide');
          })
        }
      },
    });
  });

</script>
