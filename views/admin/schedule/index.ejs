<%- include('../../includes/header.ejs') %>
</head>

<body>
  <%- include('../../includes/navbar.ejs') %>
  <div class="container-fluid">
    <div class="card">
      <div class="card-header">
        <strong>PLEASE SELECT THE SCHOOL YEAR & SEMESTER</strong>
      </div>
      <div class="card-body" id="scheduleCard">
        <form id="schedule-form">
          <div class="row mb-3">
            <div class="col-4">
              <label class="form-label" for="program">Select Porgram:</label>
              <select class="form-select" name="program" id="program" disabled>
                <option value="" selected disabled>--Please Select Program--</option>
              </select>
            </div>
            <div class="col-4">
              <label class="form-label" for="year_level">Select Year Level:</label>
              <select class="form-select" name="year_level" id="year_level" disabled>
                <option value="" selected disabled>--Please Select Year level--</option>
              </select>
            </div>
            <div class="col-4">
              <label class="form-label" for="section">Select Sections:</label>
              <select class="form-select" name="section" id="section" disabled>
                <option value="" selected disabled>--Please Select Section--</option>
              </select>
            </div>
          </div>
          <div class="row">
            <div class="col-1 offset-9">
              <button class="btn btn-primary d-none" id="submit" type="button">Submit</button>
            </div>
          </div>
        </form>


        <div class="row d-none" id="scheduleContent">
          <div class="col-3">
            <div class="mb-3 mt-2">
              <a class="btn btn-primary" id="facultyLink" target="_blank">Assign Faculties</a>
            </div>
            <label for="room" class="form-label">Select Room:</label>
            <select class="form-select" name="room" id="roomForm">
              <option value="" disabled selected>--Select Room--</option>
            </select>
            <div id='external-events' class="mt-3">
              <div class="mt-3">
                <p>
                  <strong>Lecture:</strong>
                </p>
                <div class="card" style="width: 18rem;">
                  <ul class="list-group list-group-flush" id="lectureList">
                  </ul>
                </div>
              </div>
              <div class="mt-3">
                <p>
                  <strong>Laboratory:</strong>
                </p>
                <div class="card" style="width: 18rem;">
                  <ul class="list-group list-group-flush" id="labList">
                  </ul>
                </div>
              </div>
            </div>
          </div>
          <div class="col-9">
            <div id='calendar-container'>
              <div id="calendar"></div>
            </div>
          </div>
        </div>
      </div>


    </div>
    <input type="hidden" name="_csrf" value="<%= csrf %>" id="csrf">
    <input type="hidden" name="_csrf" value="<%= semester %>" id="semester-id">
    <%- include('../../includes/footer.ejs') %>
    <script src="/js/schedule.js"></script>
</body>

</html>
