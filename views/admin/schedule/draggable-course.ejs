
<div id='external-events'>
  <p>
    <strong>Course List</strong>
  </p>
  <div class="card" style="width: 18rem;">
    <ul class="list-group list-group-flush">
      <% schedules.forEach(schedule => { %>
      <li class="list-group-item fc-event " course="<%= schedule.course._id %>" units="<%= schedule.course.units %>"><%= schedule.course.course_code %> (<%= schedule.course.course_description %>)</li>
      <% }) %>
    </ul>

  </div>

  <input type="hidden" name="_csrf" value="<%= csrf %>" id="csrf">
</div>
