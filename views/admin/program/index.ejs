<%- include('../../includes/header.ejs') %>
</head>

<body>
  <%- include('../../includes/navbar.ejs') %>
  <div class="container">
    <div class="card">
      <div class="card-header">
        <strong>LIST OF AVAILABLE PROGRAM/S</strong>
        <button type="button" class="btn btn-sm btn-primary float-end" data-bs-toggle="modal" data-bs-target="#addModal">
          Add New Program
        </button>
      </div>
      <div class="card-body">
        <table id="programTable" class="table table-striped" style="width:100%">
          <thead>
            <tr>
              <th>Program Code</th>
              <th>Program Name</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>

          </tbody>
        </table>
      </div>
    </div>
  </div>
  <div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="editModalLabebl" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h1 class="modal-title fs-5" id="editModalLabebl">New message</h1>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <form class="needs-validation">
            <div class="mb-3">
              <label for="program-code" class="col-form-label">Program Code:</label>
              <input type="text" class="form-control" id="program-code">
              <div class="invalid-feedback">
              </div>
            </div>
            <div class="mb-3">
              <label for="program-name" class="col-form-label">Program Name:</label>
              <input type="text" class="form-control" id="program-name">
              <div class="invalid-feedback">
              </div>
            </div>
          </form>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
          <button type="button" class="btn btn-primary" id="edit-button">Edit</button>
        </div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="addModal" tabindex="-1" aria-labelledby="addModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="addModalLabel">Adding new program</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <form id="addForm" class="needs-validation" novalidate>
            <div class="mb-3">
              <label for="program-code" class="col-form-label">Program Code:</label>
              <input type="text" class="form-control" id="program-code">
              <div class="invalid-feedback">
              </div>
            </div>
            <div class="mb-3">
              <label for="program-name" class="col-form-label">Program Name:</label>
              <input type="text" class="form-control" id="program-name">
              <div class="invalid-feedback">
              </div>
            </div>
          </form>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
          <button type="button" class="btn btn-primary" id="add-button">Submit</button>
        </div>
      </div>
    </div>
  </div>

  <input type="hidden" value="<%= csrf %> " name="csrf" id="csrf">
  <%- include('../../includes/footer.ejs') %>
  <script src="/js/program.js"></script>
</body>

</html>
