<%- include('../../includes/header.ejs') %>
</head>

<body>
  <%- include('../../includes/navbar.ejs') %>
  <div class="content-wrapper container">
    <div class="page-heading">
      <span class="h3">List of Rooms</span>
      <button type="button" class="btn btn-primary btn-sm  float-end" data-bs-toggle="modal" data-bs-target="#uploadModal">
        Upload Spreadsheet
      </button>
      <button type="button" class="btn btn-sm btn-primary me-1 float-end" data-bs-toggle="modal" data-bs-target="#addModal">
        Add New Room
      </button>
    </div>
    <div class="page-content">
      <section class="row">
        <div class="col-12">
          <div class="card">
            <div class="card-body">
              <div class="table-responsive">
                <div class="card-body">
                  <table id="roomTable" class="table table-striped" style="width:100%">
                    <thead>
                      <tr>
                        <th>Room Name</th>
                        <th>Laboratory</th>
                        <th>Actions</th>
                      </tr>
                    </thead>
                    <tbody>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>

  <div class="modal fade" id="uploadModal" tabindex="-1" aria-labelledby="uploadModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h1 class="modal-title fs-5" id="uploadModalLabel">Upload Spreadsheet</h1>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <form id="uploadForm">
            <div class="mb-3">
              <label for="spreadsheet" class="col-form-label">Insert File:</label>
              <input type="file" name="spreadsheet" class="form-control" id="spreadsheet" accept="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"">
              <div class=" invalid-feedback">
            </div>
        </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        <button type="button" id="uploadButton" class="btn btn-primary">Save changes</button>
      </div>
    </div>
  </div>
  </div>

  <div class="modal fade" id="addModal" tabindex="-1" aria-labelledby="addModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="addModalLabel">Adding new room</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <form id="addForm" class="needs-validation" novalidate>
            <div class="mb-3">
              <label for="room-name" class="col-form-label">Room Name:</label>
              <input type="text" class="form-control" id="roomName">
              <div class="invalid-feedback">
              </div>
            </div>
            <div class="mb-3">
              <div class="form-check">
                <input type="checkbox" class="form-check-input" id="laboratory">
                <label for="laboratory" class="form-check-label">Laboratory</label>
                <div class="invalid-feedback">
                </div>
              </div>
            </div>
          </form>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
          <button type="button" class="btn btn-primary" id="addButton">Submit</button>
        </div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="editModalLabebl" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h1 class="modal-title fs-5" id="editModalLabebl">Editing room</h1>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <form class="needs-validation">
            <div class="mb-3">
              <label for="room-name" class="col-form-label">Room Name:</label>
              <input type="text" class="form-control" id="roomName">
              <div class="invalid-feedback">
              </div>
            </div>
            <div class="mb-3">
              <div class="form-check">
                <input type="checkbox" class="form-check-input" id="laboratory">
                <label for="laboratory" class="form-check-label">Laboratory</label>
                <div class="invalid-feedback">
                </div>
              </div>
            </div>
          </form>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
          <button type="button" class="btn btn-primary" id="editButton">Edit</button>
        </div>
      </div>
    </div>
  </div>

  <input type="hidden" value="<%= csrf %>" id="csrf">
  <%- include('../../includes/footer.ejs') %>
  <script src="/js/room.js"></script>
</body>

</html>