<%- include('../../includes/header.ejs') %>
</head>

<body>
  <%- include('../../includes/navbar.ejs') %>
  <div class="container">
    <div class="card">
      <div class="card-header">
        <strong><%= edit ? 'EDITING A ROOM' : 'ADDING NEW ROOM'  %></strong>
      </div>
      <div class="card-body">
        <form
            class="needs-validation"
            action="/admin/rooms/<%= edit ? 'edit/'+room._id : 'add'  %>"
            method="post"
        >
          <div class="mb-4 col-6 offset-3">
            <label
                class="form-label"
                for="room_name"
            >Room Name</label>
            <input
                class="form-control <%= errors.find(e => e.param === 'room_name') ? 'is-invalid': 'is-valid'%>"
                value="<%= room ? room.room_name: ''  %>"
                name="room_name"
                id="room_name"
                type="text"
                placeholder="COMP-00000"
            >
            <% if (errors.find(e => e.param === 'room_name')) { %>
            <div class="invalid-feedback">
              <%= errors.find(e => e.param === 'room_name').msg %>
            </div>
            <% } %>
          </div>
          <div class="mb-4 col-6 offset-3">
            <div class="form-check form-switch">
              <input
                  class="form-check-input <%= errors.find(e => e.param === 'laboratory') ? 'is-invalid' : 'valid' %>"
                  name="laboratory"
                  type="checkbox"
                  role="switch"
                  id="laboratory"
                  checked="<?=room.laboratory%>"
              >
              <label
                  class="form-check-label"
                  for="laboratory"
              >is laboratory?</label>
            </div>
          </div>
          <div class="col-6 offset-3">
            <input
                type="hidden"
                name="_csrf"
                value="<%= csrf %>"
            >
            <button
                type="submit"
                class="btn btn-primary float-end"
            >Submit</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <%- include('../../includes/footer.ejs') %>
