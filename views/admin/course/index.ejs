<%- include('../../includes/header.ejs') %>
</head>

<body>
  <%- include('../../includes/navbar.ejs') %>
  <div class="container-fluid mt-3">
    <div class="card">
      <div class="card-header">
        <strong>LIST OF AVAILABLE COURSE/S</strong>
        <div class="float-end">
          <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#uploadModal">
            Upload Spreadsheet
          </button>
          <button type="button" class="btn btn-sm btn-primary " data-bs-toggle="modal" data-bs-target="#addModal">
            Add New Course
          </button>
        </div>
      </div>
      <div class="card-body">
        <div class="container-fluid">
          <div class="row">
            <div class="col-12">
              <div class="table-responsive">
                <table id="courseTable" class="table table-striped datatables" style="width:100%">
                  <thead>
                    <tr>
                      <th class='text-center' width="10%">Course Code</th>
                      <th class='text-center' width="10%">Custom Title</th>
                      <th class='text-center' width="15%">Course Title</th>
                      <th class='text-center' width="3%">Lecture</th>
                      <th class='text-center' width="3%">Lab</th>
                      <th class='text-center' width="3%">Units</th>
                      <th class='text-center' width="15%">Academic Qualification</th>
                      <th class='text-center' width="3%">Experience Required</th>
                      <th class='text-center' width="3%">Degree Required</th>
                      <th class='text-center' width="20%">Required Professional License
                      <th class='text-center' width="5%">Required Examination
                      </th>
                      <th class='text-center' width="15%">Actions</th>
                    </tr>
                  </thead>
                  <tbody class="text-center">

                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="uploadModal" tabindex="-1" aria-labelledby="uploadModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h1 class="modal-title fs-5" id="uploadModalLabel">Upload Spreadsheet</h1>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <form id="uploadForm">
            <div class="mb-3">
              <label for="spreadsheet" class="col-form-label">Insert File:</label>
              <input type="file" name="spreadsheet" class="form-control" id="spreadsheet" accept="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"">
              <div class=" invalid-feedback">
            </div>
        </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        <button type="button" id="uploadButton" class="btn btn-primary">Save changes</button>
      </div>
    </div>
  </div>
  </div>

  <div class="modal fade" id="addModal" tabindex="-1" aria-labelledby="addModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="addModalLabel">Adding new program</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <form id="addForm" class="needs-validation" novalidate>
            <div class="container-fluid">
              <div class="row mb-3">
                <div class="col-12">
                  <label for="courseCode" class="col-form-label">Course Code:</label>
                  <input type="text" class="form-control" id="courseCode">
                  <div class="invalid-feedback">
                  </div>
                </div>
              </div>
              <div class="row mb-3">
                <div class="col-12">
                  <label for="customTitle" class="col-form-label">Custom Title:</label>
                  <input type="text" class="form-control" id="customTitle">
                  <div class="invalid-feedback">
                  </div>
                </div>
              </div>
              <div class="row mb-3">
                <div class="col-12">
                  <label for="courseDescription" class="col-form-label">Course Description:</label>
                  <input type="text" class="form-control" id="courseDescription">
                  <div class="invalid-feedback">
                  </div>
                </div>
              </div>
              <div class="row mb-3">
                <div class="col-md-4">
                  <label for="units" class="col-form-label">Units:</label>
                  <input type="text" class="form-control" id="units">
                  <div class="invalid-feedback">
                  </div>
                </div>
                <div class="col-md-4">
                  <label for="lecture" class="col-form-label">Lecture: </label>
                  <input type="text" class="form-control" id="lecture">
                  <div class="invalid-feedback">
                  </div>
                </div>
                <div class="col-md-4">
                  <label for="lab" class="col-form-label">Lab: </label>
                  <input type="text" class="form-control" id="lab">
                  <div class="invalid-feedback">
                  </div>
                </div>
              </div>
              <div class="row mb-3">
                <div class="col-12">
                  <label for="academicQualification" class="col-form-label">Academic Qualification: </label>
                  <select class="form-control" id="academicQualification"></select>
                  <div class="invalid-feedback">
                  </div>
                </div>
              </div>
              <div class="row mb-3">
                <div class="col-md-6">
                  <label for="experience" class="form-label">Years of Experience Required: </label>
                  <input type="number" class="form-control" id="experience" value="0">
                  <div class="invalid-feedback">
                  </div>
                </div>
                <div class="col-md-6">
                  <label for="degree" class="form-label">Required Degree: </label>
                  <select id="degree" class="form-select">
                    <option value="1">Associate's Degree</option>
                    <option value="2">Bachelor's Degree</option>
                    <option value="3">Master's Degree</option>
                    <option value="3">Doctoral</option>
                  </select>
                  <div class="invalid-feedback">
                  </div>
                </div>
              </div>
              <div class="row mb-3">
                <div class="col-12">
                  <label for="licenseIndustry" class="form-label">Required Professional License and Industry Qualification: </label>
                  <select class="form-control" id="licenseIndustry" multiple></select>
                  <div class="invalid-feedback">
                  </div>
                </div>
              </div>
              <div class="row mb-3">
                <div class="col-12">
                  <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="examination">
                    <label class="form-check-label" for="examination">
                      Required Examination
                    </label>
                  </div>
                </div>
              </div>
            </div>
          </form>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Close</button>
          <button type="button" class="btn btn-primary" id="addButton">Submit</button>
        </div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="editModalLabebl" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h1 class="modal-title fs-5" id="editModalLabebl">Editing Course</h1>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <form class="needs-validation">
            <div class="container-fluid">
              <div class="row mb-3">
                <div class="col-12">
                  <label for="courseCode" class="col-form-label">Course Code:</label>
                  <input type="text" class="form-control" id="courseCode">
                  <div class="invalid-feedback">
                  </div>
                </div>
              </div>
              <div class="row mb-3">
                <div class="col-12">
                  <label for="customTitle" class="col-form-label">Custom Title:</label>
                  <input type="text" class="form-control" id="customTitle">
                  <div class="invalid-feedback">
                  </div>
                </div>
              </div>
              <div class="row mb-3">
                <div class="col-12">
                  <label for="courseDescription" class="col-form-label">Course Description:</label>
                  <input type="text" class="form-control" id="courseDescription">
                  <div class="invalid-feedback">
                  </div>
                </div>
              </div>
              <div class="row mb-3">
                <div class="col-md-4">
                  <label for="units" class="col-form-label">Units:</label>
                  <input type="text" class="form-control" id="units">
                  <div class="invalid-feedback">
                  </div>
                </div>
                <div class="col-md-4">
                  <label for="lecture" class="col-form-label">Lecture: </label>
                  <input type="text" class="form-control" id="lecture">
                  <div class="invalid-feedback">
                  </div>
                </div>
                <div class="col-md-4">
                  <label for="lab" class="col-form-label">Lab: </label>
                  <input type="text" class="form-control" id="lab">
                  <div class="invalid-feedback">
                  </div>
                </div>
              </div>
              <div class="row mb-3">
                <div class="col-12">
                  <label for="academicQualification" class="col-form-label">Academic Qualification: </label>
                  <select class="form-control" id="academicQualification"></select>
                  <div class="invalid-feedback">
                  </div>
                </div>
              </div>
              <div class="row mb-3">
                <div class="col-md-6">
                  <label for="experience" class="form-label">Years of Experience Required: </label>
                  <input type="number" class="form-control" id="experience" value="0">
                  <div class="invalid-feedback">
                  </div>
                </div>
                <div class="col-md-6">
                  <label for="degree" class="form-label">Required Degree: </label>
                  <select id="degree" class="form-select">
                    <option value="1">Associate's Degree</option>
                    <option value="2">Bachelor's Degree</option>
                    <option value="3">Master's Degree</option>
                    <option value="3">Doctoral</option>
                  </select>
                  <div class="invalid-feedback">
                  </div>
                </div>
              </div>
              <div class="row mb-3">
                <div class="col-12">
                  <label for="licenseIndustry" class="form-label">Required Professional License and Industry Qualification: </label>
                  <select class="form-control" id="licenseIndustry" multiple></select>
                  <div class="invalid-feedback">
                  </div>
                </div>
              </div>
              <div class="row mb-3">
                <div class="col-12">
                  <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="examination">
                    <label class="form-check-label" for="examination">
                      Required Examination
                    </label>
                  </div>
                </div>
              </div>
            </div>
          </form>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
          <button type="button" class="btn btn-primary" id="editButton">Edit</button>
        </div>
      </div>
    </div>
  </div>
  <input type="hidden" value="<%= csrf %>" id="csrf">
  <%- include('../../includes/footer.ejs') %>
  <script src="/js/course.js"></script>
</body>

</html>