<%- include('../../includes/header.ejs') %>
</head>

<body>
  <%- include('../../includes/navbar.ejs') %>
  <div class="container">
    <div class="card">
      <div class="card-header">
        <strong><%= edit ? 'EDITING A curriculum' : 'ADDING NEW curriculum'  %></strong>
      </div>
      <div class="card-body">
        <form
            class="needs-validation"
            action="/admin/curriculums/<%= edit ? 'edit/'+curriculum._id : 'add'  %>"
            method="post"
            id="curriculum-form"
        >
          <div class="mb-4 col-6 offset-3">
            <label
                class="form-label"
                for="school_year"
            >School Year</label>
            <select                
              class="form-select <%= errors.find(e => e.param === 'program') ? 'is-invalid': 'is-valid'%>"
              name="school_year"
              id="school_year"
            >
              <option value="" disabled selected>--Please Select School Year--</option>
              <% dropdown.years.forEach(year => { %>
                <option value="<%= year._id %>"><%= year.year %> </option>
              <% }) %>
            </select>
            <% if (errors.find(e => e.param === 'school_year')) { %>
            <div class="invalid-feedback">
              <%= errors.find(e => e.param === 'school_year').msg %>
            </div>
            <% } %>
          </div>
          <div class="mb-4 col-6 offset-3">
            <label
                class="form-label"
                for="semester"
            >Semester</label>
            <select                
              class="form-select <%= errors.find(e => e.param === 'semester') ? 'is-invalid': 'is-valid'%>"
              name="semester"
              id="semester"
              disabled
            >
              <option value="" disabled selected>--Please Select Semester--</option>
              <option value="first">First Semester</option>
              <option value="second">Second Semester</option>
              <option value="summer">Summer Semester</option>
            </select>
            <% if (errors.find(e => e.param === 'semester')) { %>
            <div class="invalid-feedback">
              <%= errors.find(e => e.param === 'semester').msg %>
            </div>
            <% } %>
          </div>
          <div class="mb-4 col-6 offset-3">
            <label
                class="form-label"
                for="program"
            >Program</label>
            <select                
              class="form-select <%= errors.find(e => e.param === 'program') ? 'is-invalid': 'is-valid'%>"
              name="program"
              id="program"
              disabled
            >
            <option value="" disabled selected>--Please Select Program--</option>
              <% dropdown.programs.forEach(program => { %>
                <option value="<%= program._id %>"><%= program.program_name %> </option>
              <% }) %>
            </select>
            <% if (errors.find(e => e.param === 'program')) { %>
            <div class="invalid-feedback">
              <%= errors.find(e => e.param === 'program').msg %>
            </div>
            <% } %>
          </div>
          <div class="mb-4 col-6 offset-3">
            <label
                class="form-label"
                for="year_level"
            >Year Level</label>
            <select                
              class="form-select <%= errors.find(e => e.param === 'year_level') ? 'is-invalid': 'is-valid'%>"
              name="year_level"
              id="year_level"
              disabled
            >
            <option value="" disabled selected>--Please Select Level--</option>
              <% dropdown.levels.forEach(level => { %>
               <option value="<%= level._id %>"><%= level.level %> </option>
              <% }) %>
            </select>
            <% if (errors.find(e => e.param === 'year_level')) { %>
            <div class="invalid-feedback">
              <%= errors.find(e => e.param === 'year_level').msg %>
            </div>
            <% } %>
          </div>
          <div class="mb-4 col-6 offset-3">
            <label
                class="form-label"
                for="sections"
            >Sections</label>
            <input
                class="multi-custom <%= errors.find(e => e.param === 'sections') ? 'is-invalid': 'is-valid'%>"
                value="<%= curriculum ? curriculum.sections: ''  %>"
                name="sections"
                id="sections"
                type="text"
                disabled
            >
            <% if (errors.find(e => e.param === 'sections')) { %>
            <div class="invalid-feedback">
              <%= errors.find(e => e.param === 'sections').msg %>
            </div>
            <% } %>
          </div>
          <div class="mb-4 col-6 offset-3">
            <label
                class="form-label"
                for="courses"
            >Courses - <span id="unitCounter">0</span> Unit/s selected.</label>
            <select                
              class="multi-select <%= errors.find(e => e.param === 'courses') ? 'is-invalid': 'is-valid'%> "
              name="courses[]"
              id="courses"
              multiple="multiple"
              disabled
            >
              <% dropdown.courses.forEach(course => { %>
                <option value="<%= course._id %>"><%= course.course_code + '-' + course.course_description + ` (` + course.units + ` Units)` %> </option>
              <% }) %>
            </select>
            <% if (errors.find(e => e.param === 'courses')) { %>
            <div class="invalid-feedback">
              <%= errors.find(e => e.param === 'courses').msg %>
            </div>
            <% } %>
          </div>
          <div class="col-6 offset-3">
            <input
                type="hidden"
                name="_csrf"
                value="<%= csrf %>"
            >
            <button
                type="submit"
                class="btn btn-primary float-end"
            >Submit</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <%- include('../../includes/footer.ejs') %>

