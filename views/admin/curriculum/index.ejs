<%- include('../../includes/header.ejs') %>
</head>

<body>
  <%- include('../../includes/navbar.ejs') %>
  <div class="content-wrapper container">
    <div class="page-heading">
      <span class="h3" id="card-title">No Current Active Semester</span>
      <button type="button" class="btn btn-sm btn-primary me-1 float-end" id="copyModalButton" data-bs-toggle="modal" data-bs-target="#copyModal">
        Copy From Another Sem
      </button>
      <button type="button" class="btn btn-sm btn-primary me-1 float-end" id="addProgramModalButton" data-bs-toggle="modal" data-bs-target="#addProgramModal">
        Add Program Offered
      </button>
    </div>
    <div class="page-content">
      <section class="row">
        <div class="col-12">
          <div class="card">
            <div class="card-body">
              <div class="d-flex justify-content-center" id="content-loading">
                <div class="spinner-border" role="status">
                  <span class="visually-hidden">Loading...</span>
                </div>
              </div>
              <div class="d-none" id="content">
                <div class="row">
                  <div class="col-12">
                    <select class="form-select" id="viewProgram" disabled>
                      <option value="" disabled selected>--Select Program--</option>
                    </select>
                  </div>
                </div>
                <div class="d-none" id="yearList">
                  <div class="row m-3">
                    <div class="col-4">
                      <button class="btn btn-danger btn-sm text-light" id="removeProgram">Remove this Program</button>
                    </div>
                  </div>
                  <div class="d-flex justify-content-center m-3" id="year-loading">
                    <div class="spinner-border" role="status" aria-hidden="true"></div>
                  </div>
                  <div class="row m-3 d-none" id="nav-year">
                    <div class="col-3">
                      <div class="nav flex-column nav-pills me-3" id="v-pills-tab" role="tablist" aria-orientation="vertical">
                      </div>
                    </div>
                    <div class="col-9">
                      <div class="tab-content" id="v-pills-tabContent">
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>

  <div class="modal fade" id="addProgramModal" tabindex="-1" aria-labelledby="addProgramModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="addProgramModalLabel">Adding new program</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <form id="addForm" class="needs-validation" novalidate>
            <div class="col-12 mb-3">
              <label for="programs" class="col-form-label">Programs:</label>
              <select class="form-control" width="100%" multiple="true" id="programs">
              </select>
              <div class="invalid-feedback">
              </div>
            </div>
          </form>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
          <button type="button" class="btn btn-primary" id="addProgramsButton">Submit</button>
        </div>
      </div>
    </div>
  </div>

