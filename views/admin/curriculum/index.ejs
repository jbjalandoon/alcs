<%- include('../../includes/header.ejs') %>
</head>

<body>
  <%- include('../../includes/navbar.ejs') %>
  <div class="container-fluid px-4">
    <div class="card">
      <div class="card-header">
        <strong>LIST OF AVAILABLE CURRICULUMS/S</strong>
        <button type="button" class="btn btn-sm btn-primary float-end d-none" id="addModalButton" data-bs-toggle="modal" data-bs-target="#addModal">
          Add Program Offered
        </button>
      </div>
      <div class="card-body">
        <div class="d-flex justify-content-center" id="content-loading">
          <strong>Loading...</strong>
          <div class="spinner-border ms-auto" role="status" aria-hidden="true"></div>
        </div>
        <div class="d-none" id="content">
          <div class="row">
            <div class="col-4 offset-1">
              <select class="form-select" id="view-semester">
                <option value="" disabled selected>--Select Semester--</option>
              </select>
            </div>
            <div class="col-4">
              <select class="form-select" id="view-program" disabled>
                <option value="" disabled selected>--Select Program--</option>
              </select>
            </div>
            <div class="col-2">
              <button class="btn form-control btn-primary" id="submit-button" disabled>Submit</button>
            </div>
          </div>
          <div class="d-none" id="yearList">
            <div class="row m-3">
              <div class="col-2">
                <button type="button" class="btn btn-secondary" data-bs-toggle="modal" data-bs-target="#addYeaModal">
                  Add Year Level
                </button>
              </div>
            </div>
            <div class="d-flex justify-content-center m-3" id="year-loading">
              <div class="spinner-border" role="status" aria-hidden="true"></div>
            </div>
            <div class="row m-3 d-none" id="nav-year">
              <div class="col-3">
                <div class="nav flex-column nav-pills me-3" id="v-pills-tab" role="tablist" aria-orientation="vertical">
                </div>
              </div>
              <div class="col-9">
                <div class="tab-content" id="v-pills-tabContent">
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  </div>

  <div class="modal fade" id="addModal" tabindex="-1" aria-labelledby="addModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="addModalLabel">Adding new program</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <form id="addForm" class="needs-validation" novalidate>
            <div class="mb-3">
              <label for="program-code" class="col-form-label">Semester:</label>
              <select class="form-select" id="add-semester">
                <option value="">--Select Semester--</option>
              </select>
              <div class="invalid-feedback">
              </div>
            </div>
            <div class="col-12 mb-3">
              <label for="add-program" class="col-form-label">Programs:</label>
              <select class="form-control" width="100%" multiple="true" id="add-program">
              </select>
              <div class="invalid-feedback">
              </div>
            </div>
          </form>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
          <button type="button" class="btn btn-primary" id="add-button">Submit</button>
        </div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="addYeaModal" tabindex="-1" aria-labelledby="addYearModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="addYearModalLabel">Adding Year Level</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <form id="addYearForm" class="needs-validation" novalidate>
            <div class="mb-3">
              <label for="year-level" class="col-form-label">Year Level:</label>
              <select class="form-select" id="year-level">
                <option value="" disabled selected>--Select Year Level--</option>
              </select>
              <div class="invalid-feedback">
              </div>
            </div>
            <div class="mb-3">
              <label for="section" class="col-form-label">Sections:</label>
              <select id="section" multiple="multiple">
              </select>
              <div class="invalid-feedback">
              </div>
            </div>
            <div class="mb-3">
              <label for="course" class="col-form-label">Courses (0 Units Selected):</label>
              <select id="course">
              </select>
              <div class="invalid-feedback">
              </div>
            </div>
          </form>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
          <button type="button" class="btn btn-primary" id="add-year-button">Submit</button>
        </div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="addNewCourseModal" tabindex="-1" aria-labelledby="addNewCourseModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h1 class="modal-title fs-5" id="addNewCourseModalLabel">New message</h1>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <form>
            <div class="mb-3">
              <label for="new-course" class="col-form-label">Courses (0 Units Selected):</label>
              <select id="newCourseSelect">
              </select>
              <div class="invalid-feedback">
              </div>
            </div>
          </form>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
          <button type="button" class="btn btn-primary" id="addCourseButton">Send message</button>
        </div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="addNewSectionModal" tabindex="-1" aria-labelledby="addNewCourseModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h1 class="modal-title fs-5" id="addNewCourseModalLabel">New message</h1>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <form>
            <div class="mb-3">
              <label for="newSectionSelect" class="col-form-label">New Sections: </label>
              <select id="newSectionSelect">
              </select>
              <div class="invalid-feedback">
              </div>
            </div>
          </form>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
          <button type="button" class="btn btn-primary" id="addSectionButton">Send message</button>
        </div>
      </div>
    </div>
  </div>

  <input type="hidden" id="csrf" value="<%= csrf %>">
  <input type="hidden" id="school-year" value="<%= school_year %>">
  <%- include('../../includes/footer.ejs') %>
  <script src="/js/curriculum.js"></script>
</body>

</html>
