  <div class="modal fade" id="addNewCourseModal" tabindex="-1" aria-labelledby="addNewCourseModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
      <div class="modal-content">
        <div class="modal-header">
          <h1 class="modal-title fs-5" id="addNewCourseModalLabel">Adding Course</h1>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <form>
            <div class="mb-3">
              <label for="courses" class="col-form-label">Courses (<span id="unitsCount">0</span> Units Selected):</label>
              <select id="courses">
              </select>
              <div class="invalid-feedback">
              </div>
            </div>
          </form>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
          <button type="button" class="btn btn-primary" id="addCourseButton">Submit</button>
        </div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="addNewSectionModal" tabindex="-1" aria-labelledby="addNewCourseModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h1 class="modal-title fs-5" id="addNewCourseModalLabel">Adding New Sections</h1>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <form>
            <div class="mb-3">
              <label for="sections" class="col-form-label">Sections: </label>
              <select id="sections">
              </select>
              <div class="invalid-feedback">
              </div>
            </div>
          </form>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
          <button type="button" class="btn btn-primary" id="addSectionButton">Submit</button>
        </div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="copyModal" tabindex="-1" aria-labelledby="copyModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="copyModalLabel">Copy From Another Semester</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <form id="copyForm" class="needs-validation" novalidate>
            <div class="mb-3">
              <label for="year" class="col-form-label">School Year:</label>
              <select class="form-select" id="year">
              </select>
              <div class="invalid-feedback">
              </div>
            </div>
            <div class="mb-3">
              <label for="semester" class="col-form-label">Semester:</label>
              <select class="form-select" id="semester" disabled>
              </select>
              <div class="invalid-feedback">
              </div>
            </div>
          </form>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
          <button type="button" class="btn btn-primary disabled" id="copySubmit">Submit</button>
        </div>
      </div>
    </div>
  </div>

  <input type="hidden" id="csrf" value="<%= csrf %>">
  <%- include('../../includes/footer.ejs') %>
  <script src="/js/curriculum.js"></script>
</body>

</html>